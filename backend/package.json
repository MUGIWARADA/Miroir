{
  "name": "miroir-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Miroir MVP backend: Node.js public API, Neon-ready PostgreSQL, deterministic Python scoring integration.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,scoring -c blue,magenta \"npm:dev:api\" \"npm:dev:scoring\"",
    "dev:api": "tsx watch src/server.ts",
    "dev:scoring": "python -m uvicorn scoring.app.main:app --host 0.0.0.0 --port 8001 --reload",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check src test",
    "lint:fix": "biome check --write src test",
    "test": "tsx --test test/*.test.ts",
    "test:scoring": "python -m pytest scoring/tests -q",
    "migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/db/seed-cli.ts",
    "generate-schema": "node generate-schema.mjs",
    "openapi": "npm run generate-schema"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@fastify/cors": "^10.0.1",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.4.2",
    "@fastify/swagger-ui": "^6.1.2",
    "@fastify/type-provider-typebox": "^5.1.0",
    "@sinclair/typebox": "^0.34.14",
    "csv-parse": "^7.0.3",
    "decimal.js": "10.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/node": "^20.17.10",
    "@types/pg": "^8.11.10",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "glob": "^14.0.3"
  }
}
