# API
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=*
# Set to the exact frontend origin in production; wildcard is for local development only.
TRUST_PROXY=false
DEMO_AUTH_ENABLED=true
# Only enable for isolated browser previews that cannot persist request credentials; production rejects true.
DEMO_AUTH_FALLBACK_ENABLED=false
SESSION_TTL_HOURS=24

# Optional Roqqu staging key; keep it in the backend runtime environment only.
ROQQU_STAGING_API_KEY=

# Database
# Leave empty for local PGlite in development/tests. The current demo deployment target is server-local PostgreSQL.
# Configure runtime and direct-migration URLs securely. Neon, if used later, is a separate environment.
DATABASE_URL=
MIGRATION_DATABASE_URL=
PGLITE_DIR=.data/pglite

# Python scoring service
SCORING_SERVICE_URL=http://127.0.0.1:8001
# Local development only. Production requires a unique random value of at least 32 characters.
SCORING_SERVICE_TOKEN=dev-scoring-token

# Optional live AI is not required for this slice.
