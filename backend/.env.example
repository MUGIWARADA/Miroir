# Copy to .env for local development. Never commit real credentials.
PORT=8080
HOST=127.0.0.1
NODE_ENV=development
DATA_MODE=mock
DATABASE_URL=postgres://miroir:miroir@localhost:5432/miroir
CORS_ORIGIN=http://localhost:5173
APP_BASE_URL=http://localhost:5173
SESSION_TTL_HOURS=24
VERIFICATION_TTL_MINUTES=30

# In development, console mode prints a short-lived verification link to the API log.
# Hosted registration requires an SMTP relay; keep SMTP secrets only in backend/.env.
EMAIL_DELIVERY_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Optional staging-only key used server-side after a verified user connects their account.
# Never put this key in frontend variables or commit a non-empty value.
ROQQU_STAGING_API_KEY=
