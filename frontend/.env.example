# Browser-visible API origin. Leave empty to call the same-origin /v1 paths.
# For a hosted frontend, set this to the public Node API origin (never a secret).
VITE_API_BASE_URL=

# Local Vite dev/preview proxy target for /v1 requests.
VITE_API_PROXY_TARGET=http://127.0.0.1:8080

# The real backend is the default. Set to "mock" only for fixture-only UI work.
VITE_API_MODE=real
